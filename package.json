{
  "name": "open-ktv",
  "version": "0.1.0",
  "description": "简易版全民K歌（Web）：上传伴奏 → 带耳返演唱 → 服务端 ffmpeg 合成 MP3 / A self-hosted web karaoke: upload backing tracks, sing with monitoring, mix MP3s server-side.",
  "keywords": [
    "karaoke",
    "ktv",
    "singing",
    "audio",
    "ffmpeg",
    "react",
    "express",
    "i18n",
    "webaudio",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "stubenhuang",
  "homepage": "https://github.com/stubenhuang/open-ktv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stubenhuang/open-ktv.git"
  },
  "bugs": {
    "url": "https://github.com/stubenhuang/open-ktv/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/stubenhuang"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "server/",
    "shared/",
    "web/index.html",
    "web/public/",
    "web/src/",
    "scripts/",
    "openktv.sh",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.server.json"
  ],
  "sideEffects": [
    "web/src/styles.css",
    "web/src/mobile.css"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "serve": "npm run build && npm start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e-browser.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:license": "node scripts/check-license-headers.mjs",
    "smoke:i18n": "node scripts/smoke-i18n.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}

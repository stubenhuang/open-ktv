{
  "name": "open-ktv",
  "private": true,
  "version": "0.1.0",
  "description": "简易版全民K歌（Web）：上传伴奏 → 带耳返演唱 → 服务端 ffmpeg 合成 MP3",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "serve": "npm run build && npm start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e-browser.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    /*
     * vite.config.ts 要 import 服务端的证书模块（手机 HTTPS 与 Vite 开发服务共用
     * 同一份自签名证书，见 vite.config.ts 的 VITE_HTTPS）；服务端代码按 Node 原生
     * 类型擦除的规矩用 .ts 后缀显式引用，所以这里也得打开。noEmit 下没有副作用。
     */
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"]
  },
  "include": ["web/src", "shared", "vite.config.ts"]
}
